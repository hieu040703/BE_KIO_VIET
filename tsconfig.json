{
  "compilerOptions": {
    "target": "es2022",
    "module": "node16",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "allowSyntheticDefaultImports": true,
    "sourceMap": false,
    "declaration": false,
    "removeComments": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/index.ts",
    "src/worker.ts",
    "src/database/database.ts",
    "src/database/function/**/*.ts",
    "src/database/migrations/**/*.ts",
    "src/database/models/index.ts",
    "src/database/models/retail/**/*.ts",
    "src/modules/retail/**/*.ts",
    "src/modules/auth/**/*.ts",
    "src/routers/retail.routes.ts",
    "src/routers/auth.routes.ts",
    "src/shared/config/env.ts",
    "src/shared/config/socket.ts",
    "src/shared/middleware/cors.middleware.ts",
    "src/shared/middleware/auth.middleware.ts",
    "src/shared/middleware/error.middleware.ts",
    "src/shared/middleware/permission.middleware.ts",
    "src/shared/middleware/sse.middleware.ts",
    "src/shared/middleware/validation.middleware.ts",
    "src/shared/base/BaseController.ts",
    "src/shared/base/BaseRepository.ts",
    "src/shared/base/BaseService.ts",
    "src/shared/types/errors.ts",
    "src/shared/utils/logger.ts",
    "src/shared/utils/response.utils.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
