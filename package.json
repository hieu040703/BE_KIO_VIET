{
  "name": "be-kiot-viet",
  "version": "1.0.0",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://opensource.org/license/isc-license-txt"
    }
  ],
  "description": "Kiot Viet retail backend based on the BE_BOC_XEP_HANG_HOA service base.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register --watch src,.env src/index.ts",
    "worker": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register --watch src,.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --max-old-space-size=8192 -r tsconfig-paths/register dist/index.js",
    "start:worker": "node --max-old-space-size=8192 -r tsconfig-paths/register dist/worker.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/database/database.ts",
    "db:migrate:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/database/database.ts",
    "db:migrate:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -d src/database/database.ts",
    "db:sync": "ts-node -r tsconfig-paths/register src/database/function/schema-sync.ts",
    "db:reset": "ts-node -r tsconfig-paths/register src/database/function/schema-drop-sync.ts",
    "db:drop": "ts-node -r tsconfig-paths/register src/database/function/schema-drop.ts",
    "db:force:drop": "ts-node -r tsconfig-paths/register src/database/function/force-drop.ts",
    "db:clean:drop": "ts-node -r tsconfig-paths/register src/database/function/no-sync-drop.ts",
    "db:check": "ts-node -r tsconfig-paths/register src/database/function/check-sync.ts",
    "db:create": "ts-node -r tsconfig-paths/register src/database/schema-from-entities.ts",
    "db:recreate": "ts-node -r tsconfig-paths/register src/database/schema-from-entities.ts --recreate",
    "db:generate": "./scripts/generate-schema.sh",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "retail:model:generate": "ts-node scripts/generate-retail-generic-models.ts",
    "retail:module:generate": "ts-node scripts/generate-retail-modules.ts",
    "db:seed:admin": "ts-node scripts/seed-admin.ts",
    "db:seed:retail-demo": "ts-node scripts/seed-retail-demo.ts",
    "entity:gen": "./scripts/generate-modules.sh",
    "entity:genv2": "./scripts/generate-modules-v2.sh",
    "enum:gen": "ts-node scripts/gen-fe-enums.ts",
    "enum:gen:check": "ts-node scripts/gen-fe-enums.ts --check",
    "update:check": "npm outdated",
    "update:all": "npx npm-check-updates -u && npm install",
    "update:major": "npx npm-check-updates -u --target major && npm install",
    "update:minor": "npx npm-check-updates -u --target minor && npm install"
  },
  "keywords": [
    "express",
    "typescript",
    "typeorm",
    "inversify",
    "jwt"
  ],
  "author": "iTomo",
  "license": "ISC",
  "dependencies": {
    "@datalust/winston-seq": "^3.0.1",
    "@langchain/community": "^1.1.27",
    "@langchain/core": "^1.1.44",
    "@langchain/google-genai": "^2.1.30",
    "@langchain/openai": "^1.4.5",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.5",
    "adm-zip": "^0.5.16",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.2",
    "bull": "^3.29.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "croner": "^9.1.0",
    "dayjs": "^1.11.18",
    "decimal.js": "^10.6.0",
    "docx": "^9.5.1",
    "dotenv": "^17.2.3",
    "exceljs": "^3.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.9.0",
    "helmet": "^8.1.0",
    "inversify": "^7.11.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.3.37",
    "mammoth": "^1.12.0",
    "minio": "^8.0.6",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "ssh2": "^1.17.0",
    "tesseract.js": "5",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/archiver": "^7.0.0",
    "@types/bull": "^3.15.9",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.9.2",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.20.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "sqlite3": "^6.0.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "_moduleAliases": {
    "@": "./src"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
